linze.pro {
	handle /api/* {
		reverse_proxy localhost:8085
	}
	handle {
		reverse_proxy localhost:3000
	}
}

file.linze.pro {
	handle {
		root * /home/nicolas/linze.pro/resources
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, OPTIONS"
			Access-Control-Allow-Headers *
		}
		file_server browse
	}
}